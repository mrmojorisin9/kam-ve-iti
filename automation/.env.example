# Kam denes — automation/ okruzenje (Faza 6-7, ADR-020). Kopirati u .env
# (NIKAD commitati .env sa stvarnim vrijednostima — vec je u .gitignore).

# Supabase service_role kljuc (Project Settings -> API) — bypass RLS,
# NIKAD anon/publishable kljuc ovdje.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Claude API kljuc za ekstrakciju/kategorizaciju/dedup asistenciju.
ANTHROPIC_API_KEY=

# UUID dedicated "scraper" Supabase Auth korisnika (vidi automation/README.md
# "Jednokratni setup" — created_by MORA biti postavljen na ovaj UUID, nikad
# NULL, zbog rate-limit trigera opisanog u 0024 migraciji).
SCRAPER_USER_ID=
