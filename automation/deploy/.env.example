# Kam denes — n8n deploy okruzenje (Faza 6-7, ADR-020, Korak 5). Kopirati u
# .env NA VM-u (ne lokalno) pored docker-compose.yml. NIKAD commitati .env
# sa stvarnim vrijednostima (vec u .gitignore preko korijenskog `.env*`).

# n8n web sucelje login (Basic Auth) — pristupa se preko SSH tunela, ne
# javno, ali i dalje treba login (README, "Pristup n8n sucelju").
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# Isti kredencijali kao automation/.env — Execute Command cvor u istom
# kontejneru koristi ove env varijable izravno (vidi docker-compose.yml).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
SCRAPER_USER_ID=
