# Kam denes — n8n deploy okruzenje, lokalno preko Docker Desktop (Faza 6-7,
# ADR-020). Kopirati u .env pored docker-compose.yml. NIKAD commitati .env
# sa stvarnim vrijednostima (vec u .gitignore preko korijenskog `.env*`).
#
# n8n web sucelje login: kreira se izravno u sucelju kod prvog otvaranja
# http://localhost:5678 (owner racun, ugradjeni n8n sustav prijave — stare
# N8N_BASIC_AUTH_* varijable su no-op u modernim verzijama, namjerno
# uklonjene odavde).

# Isti kredencijali kao automation/.env — automation servis (zaseban
# kontejner) koristi ove env varijable izravno (vidi docker-compose.yml).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
SCRAPER_USER_ID=
